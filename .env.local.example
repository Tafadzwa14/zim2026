# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (create a project at https://supabase.com) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Keep this SECRET and server-only. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Flight data provider ---
# "aerodatabox" for live data, or "mock" for clearly-labelled demo flights.
FLIGHT_PROVIDER=aerodatabox
# AeroDataBox via RapidAPI: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=your-rapidapi-key
AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com

# --- Live plane position (OpenSky Network) ---
# Free for personal use. Supplies the live map position only; AeroDataBox
# still handles schedule and status. "opensky" (default) or "none".
FLIGHT_POSITION_PROVIDER=opensky
# Optional OAuth2 client credentials for higher rate limits. Without them the
# app uses anonymous access (works, but heavily rate-limited). Create an API
# client at https://opensky-network.org (Account -> API clients).
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# --- Itinerary PDF parsing ---
# People can upload a flight itinerary PDF and the app reads the legs
# (layovers included) out of it. Three readers are available:
#   local  = free, no key, deterministic. Handles Aunt Betty / Flight Centre
#            and Jetabroad PDFs. This is the default.
#   local-with-ai-fallback = try local first, then spend a tiny amount on
#            OpenAI only when the local parser cannot read the PDF.
#   openai = always use OpenAI; broadest, but costs money on every upload.
ITINERARY_PARSER=local-with-ai-fallback
# Only needed when ITINERARY_PARSER=local-with-ai-fallback or openai.
# Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
# Any current model that accepts PDF input and structured outputs.
OPENAI_MODEL=gpt-5.6-luna

# --- App secrets ---
# Random string mixed into PIN hashes. Generate: openssl rand -hex 32
APP_PIN_PEPPER=change-me-to-a-long-random-string
# One-time token so the first person can claim admin during setup. Generate one and share privately.
ADMIN_SETUP_TOKEN=change-me
