# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (create a project at https://supabase.com) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Keep this SECRET and server-only. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Flight data provider ---
# "aerodatabox" for live data, or "mock" for clearly-labelled demo flights.
FLIGHT_PROVIDER=aerodatabox
# AeroDataBox via RapidAPI: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=your-rapidapi-key
AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com

# --- Itinerary PDF parsing (OpenAI) ---
# Optional. When set, people can upload a flight itinerary PDF and the app
# reads the legs (including layovers) out of it. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
# Any current model that accepts PDF input and structured outputs.
OPENAI_MODEL=gpt-5.6

# --- App secrets ---
# Random string mixed into PIN hashes. Generate: openssl rand -hex 32
APP_PIN_PEPPER=change-me-to-a-long-random-string
# One-time token so the first person can claim admin during setup. Generate one and share privately.
ADMIN_SETUP_TOKEN=change-me
